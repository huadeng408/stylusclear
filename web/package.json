{
  "name": "stylusclear-workbench",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Deterministic clearing workbench and live Arbitrum Sepolia / Orbit / Robinhood Chain JSON-RPC adapter for StylusClear",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild rpc-client.ts --bundle --format=esm --platform=browser --outfile=dist/rpc-client.mjs",
    "test": "node --test ../tests/test_seam_s3_workbench.mjs",
    "serve": "python3 -m http.server 8080"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
