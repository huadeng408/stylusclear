# Reproducible WASM 1.0 MVP build environment for StylusClear v1.1.0 (zero curl|sh)
FROM rust:1.91.0-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    binaryen \
    python3 \
    python3-brotli \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add wasm32-unknown-unknown

WORKDIR /workspace
COPY Cargo.toml Cargo.lock rust-toolchain.toml Stylus.toml ./
COPY .cargo ./.cargo
COPY crates ./crates
COPY scripts/optimize-wasm-mvp.py ./scripts/optimize-wasm-mvp.py

RUN cargo build --locked --release --target wasm32-unknown-unknown -p clearing-stylus \
    && python3 scripts/optimize-wasm-mvp.py \
       target/wasm32-unknown-unknown/release/clearing_stylus.wasm \
       artifacts/clearing_stylus.wasm --json
RUN useradd -m -u 10001 builder && chown -R builder:builder /workspace
USER builder
